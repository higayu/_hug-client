{
  "manifest_version": 3,
  "name": "伴走ナビ (プロトタイプ)",
  "version": "1.0.0",
  "description": "HUG支援記録 AI入力サポートツール",
  "action": {
    "default_title": "伴走ナビを開く"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.ts",
    "type": "module"
  },
  "permissions": [
    "sidePanel"
  ]
}

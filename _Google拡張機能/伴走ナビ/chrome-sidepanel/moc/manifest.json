{
  "manifest_version": 3,
  "name": "伴走ナビ (プロトタイプ)",
  "version": "1.0.0",
  "description": "HUG支援記録 AI入力サポートツール",
  "action": {
    "default_title": "伴走ナビを開く",
    "default_icon": {
      "48": "icon.svg"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "http://192.168.3.35:3001/*",
    "http://192.168.1.229:3001/*",
    "http://localhost:3001/*",
    "http://localhost:11434/*",
    "https://generativelanguage.googleapis.com/*",
    "https://www.hug-ayumu.link/hug/wm/*"
  ]
}

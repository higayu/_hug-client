{
  "manifest_version": 3,
  "name": "HUG 入室退室管理及び記録の確認機能",
  "version": "1.0.0",
  "description": "入室退室管理及び記録の確認機能",
  "content_scripts": [
    {
      "matches": [
        "https://www.hug-ayumu.link/hug/wm/*"
      ],
      "exclude_matches": [
        "https://www.hug-ayumu.link/hug/wm/addition_plan.php*",
        "https://www.hug-ayumu.link/hug/wm/contact_book.php?mode=edit&*"
      ],
      "js": [
        "content.js",
        "attendance-post-common.js",
        "enter-post.js",
        "leave-post.js",
        "mail-dialog.js",
        "enter-mail-export.js",
        "native-delegate.js",
        "alert-type2-popup.js",
        "form/form-styles.js",
        "form/form-helpers.js",
        "form/form-state.js",
        "form/form-events.js",
        "form/personal-record-tab.js",
        "form/form-panel.js",
        "form/form-render.js",
        "form/form.js",
        "timer.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://www.hug-ayumu.link/hug/wm/*"
  ]
}
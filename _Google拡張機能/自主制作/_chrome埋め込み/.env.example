# AI / API 設定（ビルド時にバンドルされます。変更後は npm run build を再実行）
#
# Chrome 拡張機能から Ollama を使う場合:
#   環境変数 OLLAMA_ORIGINS=* を設定 → Ollama アプリを再起動

VITE_AI_PROVIDER=ollama
VITE_AI_MODEL=jp-assistant:latest
VITE_OLLAMA_MODEL=
VITE_GEMINI_MODEL=
VITE_OLLAMA_BASE_URL=http://localhost:11434
VITE_GEMINI_API_KEY=
VITE_API_BASE=http://127.0.0.1:8000/api

{
  "manifest_version": 3,
  "name": "HUG 入室退室をページをまたいで取得",
  "version": "1.0.0",
  "description": "HTML を取得してコンソールに出力します。",
  "content_scripts": [
    {
      "matches": [
        "https://www.hug-ayumu.link/hug/wm/"
      ],
      "js": [
        "content.js",
        "form.js",
        "timer.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://www.hug-ayumu.link/hug/wm/*"
  ]
}
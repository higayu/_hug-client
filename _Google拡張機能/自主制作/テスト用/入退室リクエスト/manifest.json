{
  "manifest_version": 3,
  "name": "HUG 入室退室をページをまたいで取得",
  "version": "1.4.4",
  "description": "HTML を取得してコンソールに出力します。",
  "content_scripts": [
    {
      "matches": [
        "https://www.hug-ayumu.link/hug/wm/*"
      ],
      "js": [
        "content.js",
        "attendance-post-common.js",
        "enter-post.js",
        "leave-post.js",
        "mail-dialog.js",
        "enter-mail-export.js",
        "native-delegate.js",
        "alert-type2-popup.js",
        "form/form-styles.js",
        "form/form-helpers.js",
        "form/form-state.js",
        "form/form-events.js",
        "form/form-panel.js",
        "form/form-render.js",
        "form/form.js",
        "timer.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://www.hug-ayumu.link/hug/wm/*"
  ]
}